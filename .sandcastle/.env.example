# Copy to .sandcastle/.env if you want to override a default. Entirely
# optional — auth comes from the auth.json symlink that
# .sandcastle/pi-home/setup.sh creates, so there is usually nothing to put here.
#
# TICKET is required, but pass it on the command line:
#   DRY_RUN=1 TICKET=8 npm run complete-ticket

# Model that writes the code. Default: openrouter/deepseek/deepseek-v4-flash-0731
# IMPL_MODEL=openrouter/deepseek/deepseek-v4-flash-0731

# Model that reviews it. Default: claude-bridge/claude-opus-5
# REVIEW_MODEL=claude-bridge/claude-opus-5

# Branch worktrees are cut from, and merged back into. Default: main
# BASE_BRANCH=main

# Implement attempts after the first before the ticket is parked. Default: 2
# MAX_RETRIES=2

# Set to 1 to run everything locally but skip every remote write: no push, no
# pull request, no issue comment or relabel. The worktree is kept afterwards.
# DRY_RUN=1
