<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime denies the microphone outright without this, and does
	     it silently: AVCaptureDevice.requestAccess returns false and no system
	     prompt is ever shown, so the permission sits at "not determined" forever. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- WhisperKit runs CoreML models it downloaded at runtime, which the hardened
	     runtime treats as unsigned code unless this is allowed. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
